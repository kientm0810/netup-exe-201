APP_ENV=development
DATABASE_URL=postgresql+psycopg://netup:netup@postgres:5432/netup
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

APP_SECRET_KEY=replace-with-long-random-secret
AUTH_COOKIE_SECURE=false

USER_ACCESS_TOKEN_MINUTES=30
USER_REFRESH_TOKEN_DAYS=30
ADMIN_ACCESS_TOKEN_MINUTES=30
ADMIN_REFRESH_TOKEN_DAYS=14
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_BLOCK_MINUTES=15

ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@netup.local
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me
USER_IMPORT_ENABLED=false
USER_IMPORT_SOURCE_PATH=/app/new_user.txt

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

BACKEND_BASE_URL=http://localhost:8000
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8000/api/v1/payments/vnpay/return
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
VIDEO_ASSESSMENT_MAX_SIZE_MB=5
VIDEO_ASSESSMENT_MAX_DURATION_SECONDS=60
VIDEO_ASSESSMENT_STORAGE_DIR=/tmp/netup-video-assessments
LOCAL_UPLOAD_STORAGE_DIR=/app/uploads
